<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../includes/head', { title: 'Admin Panel', styles: ['admin.css'], extraHead: '' }) %>
</head>
<body>
    <%- include('../includes/skip-link') %>

    <header>
        <div class="header-content">
            <h1><span class="logo-icon">&#9881;</span> Admin Panel</h1>
            <p>System administration and user management</p>
        </div>
    </header>

    <%- include('../includes/nav-admin', { currentPage: 'admin' }) %>

    <main class="container" id="main-content" role="main">
        <div id="accessDenied" class="access-denied" style="display: none;">
            <h2>&#128683; Access Denied</h2>
            <p>You do not have permission to access the admin panel.</p>
            <a href="/" class="btn-primary">Return to Home</a>
        </div>

        <div id="adminContent" style="display: none;">
            <section class="admin-section" aria-labelledby="overview-heading">
                <h2 id="overview-heading">&#128202; System Overview</h2>
                <div class="admin-stats-grid">
                    <div class="admin-stat-card">
                        <span class="stat-icon">&#128101;</span>
                        <span class="stat-value" id="totalUsers">-</span>
                        <span class="stat-label">Total Users</span>
                    </div>
                    <div class="admin-stat-card">
                        <span class="stat-icon">&#9989;</span>
                        <span class="stat-value" id="activeUsers">-</span>
                        <span class="stat-label">Active Users</span>
                    </div>
                    <div class="admin-stat-card">
                        <span class="stat-icon">&#128196;</span>
                        <span class="stat-value" id="totalEntries">-</span>
                        <span class="stat-label">Total Entries</span>
                    </div>
                    <div class="admin-stat-card">
                        <span class="stat-icon">&#128081;</span>
                        <span class="stat-value" id="adminCount">-</span>
                        <span class="stat-label">Admins</span>
                    </div>
                </div>
            </section>

            <section class="admin-section" aria-labelledby="actions-heading">
                <h2 id="actions-heading">&#9889; Quick Actions</h2>
                <div class="admin-actions">
                    <a href="/admin/users" class="admin-action-btn">
                        <span class="action-icon">&#128101;</span>
                        <span class="action-text">Manage Users</span>
                    </a>
                    <button id="refreshStats" class="admin-action-btn">
                        <span class="action-icon">&#128260;</span>
                        <span class="action-text">Refresh Stats</span>
                    </button>
                </div>
            </section>

            <div class="admin-two-column">
                <section class="admin-section" aria-labelledby="roles-heading">
                    <h2 id="roles-heading">&#128101; Users by Role</h2>
                    <div class="role-breakdown" id="roleBreakdown"></div>
                </section>

                <section class="admin-section" aria-labelledby="categories-heading">
                    <h2 id="categories-heading">&#128193; Entries by Category</h2>
                    <div class="category-breakdown" id="categoryBreakdown"></div>
                </section>
            </div>

            <section class="admin-section" aria-labelledby="activity-heading">
                <h2 id="activity-heading">&#128200; Activity (Last 7 Days)</h2>
                <div class="chart-container">
                    <canvas id="activityChart" role="img" aria-label="Activity chart"></canvas>
                </div>
            </section>

            <section class="admin-section" aria-labelledby="recent-users-heading">
                <h2 id="recent-users-heading">&#128101; Recent Users</h2>
                <div class="admin-table-container">
                    <table class="admin-table" role="grid">
                        <thead>
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col">Email</th>
                                <th scope="col">Role</th>
                                <th scope="col">Status</th>
                                <th scope="col">Joined</th>
                            </tr>
                        </thead>
                        <tbody id="recentUsersTable"></tbody>
                    </table>
                </div>
                <a href="/admin/users" class="view-all-link">View all users &rarr;</a>
            </section>

            <!-- Coupon Management -->
            <section class="admin-section" aria-labelledby="coupons-heading">
                <h2 id="coupons-heading">&#127915; AI Coupons</h2>
                <div style="margin-bottom: var(--space-md);">
                    <form id="createCouponForm" style="display:flex; gap:var(--space-sm); flex-wrap:wrap; align-items:flex-end;">
                        <div class="form-group" style="margin-bottom:0">
                            <label for="couponCode" style="font-size:var(--text-xs); color:var(--text-muted)">Code</label>
                            <input type="text" id="couponCode" placeholder="e.g. FREE30" style="padding:var(--space-sm); background:var(--bg-secondary); border:1px solid var(--border); border-radius:var(--radius-md); color:var(--text); text-transform:uppercase; min-height:38px;">
                        </div>
                        <div class="form-group" style="margin-bottom:0">
                            <label for="couponDays" style="font-size:var(--text-xs); color:var(--text-muted)">Days</label>
                            <input type="number" id="couponDays" value="30" min="1" style="padding:var(--space-sm); background:var(--bg-secondary); border:1px solid var(--border); border-radius:var(--radius-md); color:var(--text); width:80px; min-height:38px;">
                        </div>
                        <div class="form-group" style="margin-bottom:0">
                            <label for="couponMaxUses" style="font-size:var(--text-xs); color:var(--text-muted)">Max Uses</label>
                            <input type="number" id="couponMaxUses" value="100" min="1" style="padding:var(--space-sm); background:var(--bg-secondary); border:1px solid var(--border); border-radius:var(--radius-md); color:var(--text); width:80px; min-height:38px;">
                        </div>
                        <button type="submit" class="btn-primary" style="min-height:38px">Create Coupon</button>
                    </form>
                </div>
                <div class="admin-table-container">
                    <table class="admin-table" role="grid">
                        <thead>
                            <tr>
                                <th scope="col">Code</th>
                                <th scope="col">Duration</th>
                                <th scope="col">Usage</th>
                                <th scope="col">Status</th>
                                <th scope="col">Created</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="couponsTable">
                            <tr><td colspan="6" class="loading">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="admin-section" aria-labelledby="recent-entries-heading">
                <h2 id="recent-entries-heading">&#128196; Recent Entries</h2>
                <div class="admin-table-container">
                    <table class="admin-table" role="grid">
                        <thead>
                            <tr>
                                <th scope="col">Title</th>
                                <th scope="col">Author</th>
                                <th scope="col">Category</th>
                                <th scope="col">Created</th>
                            </tr>
                        </thead>
                        <tbody id="recentEntriesTable"></tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>

    <%- include('../includes/footer', { showTech: false }) %>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/js/auth.js"></script>
    <script src="/js/admin.js"></script>
</body>
</html>
