<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../includes/head', { title: 'User Management', styles: ['admin.css'], extraHead: '' }) %>
</head>
<body>
    <%- include('../includes/skip-link') %>

    <header>
        <div class="header-content">
            <h1><span class="logo-icon">&#128101;</span> User Management</h1>
            <p>Manage all registered users</p>
        </div>
    </header>

    <%- include('../includes/nav-admin', { currentPage: 'users' }) %>

    <main class="container" id="main-content" role="main">
        <div id="accessDenied" class="access-denied" style="display: none;">
            <h2>&#128683; Access Denied</h2>
            <p>You do not have permission to access user management.</p>
            <a href="/" class="btn-primary">Return to Home</a>
        </div>

        <div id="adminContent" style="display: none;">
            <section class="admin-section">
                <h2>&#128269; Filter Users</h2>
                <div class="user-filters">
                    <select id="roleFilter" aria-label="Filter by role">
                        <option value="">All Roles</option>
                        <option value="user">Users</option>
                        <option value="moderator">Moderators</option>
                        <option value="admin">Admins</option>
                    </select>
                    <select id="statusFilter" aria-label="Filter by status">
                        <option value="">All Status</option>
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                    <input type="text" id="searchInput" placeholder="Search by name or email..." aria-label="Search users">
                </div>
            </section>

            <section class="admin-section">
                <h2>&#128101; All Users</h2>
                <div class="admin-table-container">
                    <table class="admin-table" role="grid">
                        <thead>
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col">Email</th>
                                <th scope="col">Role</th>
                                <th scope="col">Status</th>
                                <th scope="col">Entries</th>
                                <th scope="col">Last Login</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="usersTable">
                            <tr><td colspan="7" class="loading">Loading users...</td></tr>
                        </tbody>
                    </table>
                </div>
                <div id="pagination" class="pagination"></div>
            </section>
        </div>
    </main>

    <%- include('../includes/footer', { showTech: false }) %>

    <script src="/js/auth.js"></script>
    <script src="/js/admin.js"></script>
</body>
</html>
