<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('includes/head', { title: 'Dashboard', styles: [], extraHead: `
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: var(--space-lg);
            margin-bottom: var(--space-xl);
        }
        .stat-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: var(--space-lg);
            display: flex;
            flex-direction: column;
            gap: var(--space-sm);
        }
        .stat-card .stat-icon { font-size: 2rem; margin-bottom: var(--space-sm); }
        .stat-card .stat-value { font-size: var(--text-3xl); font-weight: 700; color: var(--primary); }
        .stat-card .stat-label { color: var(--text-muted); font-size: var(--text-sm); }
        .stat-card .stat-change { font-size: var(--text-xs); margin-top: var(--space-xs); }
        .stat-change.positive { color: var(--success); }
        .stat-change.negative { color: var(--danger); }
        .dashboard-section {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: var(--space-lg);
            margin-bottom: var(--space-lg);
        }
        .dashboard-section h2 {
            font-size: var(--text-xl);
            margin-bottom: var(--space-md);
            display: flex;
            align-items: center;
            gap: var(--space-sm);
        }
        .chart-container { height: 300px; position: relative; }
        .category-list { display: flex; flex-direction: column; gap: var(--space-sm); }
        .category-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: var(--space-sm) var(--space-md);
            background: var(--bg-secondary);
            border-radius: var(--radius-md);
        }
        .category-item .category-name { display: flex; align-items: center; gap: var(--space-sm); }
        .category-item .category-count { font-weight: 600; color: var(--primary); }
        .category-bar {
            height: 4px;
            background: var(--primary);
            border-radius: var(--radius-full);
            margin-top: var(--space-xs);
        }
        .tag-cloud { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
        .tag-cloud .tag {
            padding: var(--space-xs) var(--space-md);
            background: var(--bg-secondary);
            border-radius: var(--radius-full);
            font-size: var(--text-sm);
            cursor: pointer;
            transition: all var(--transition-fast);
        }
        .tag-cloud .tag:hover { background: var(--primary); color: white; }
        .tag-cloud .tag.size-lg { font-size: var(--text-lg); font-weight: 600; }
        .tag-cloud .tag.size-md { font-size: var(--text-base); }
        .tag-cloud .tag.size-sm { font-size: var(--text-sm); }
        .recent-entries-list { display: flex; flex-direction: column; gap: var(--space-sm); }
        .recent-entry {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: var(--space-md);
            background: var(--bg-secondary);
            border-radius: var(--radius-md);
            text-decoration: none;
            color: inherit;
            transition: all var(--transition-fast);
        }
        .recent-entry:hover { background: var(--primary); color: white; }
        .recent-entry .entry-title { font-weight: 500; }
        .recent-entry .entry-meta { font-size: var(--text-sm); color: var(--text-muted); }
        .recent-entry:hover .entry-meta { color: rgba(255,255,255,0.8); }
        .streak-display { display: flex; gap: var(--space-xl); justify-content: center; text-align: center; }
        .streak-item { display: flex; flex-direction: column; gap: var(--space-xs); }
        .streak-value { font-size: var(--text-3xl); font-weight: 700; color: var(--primary); }
        .streak-label { font-size: var(--text-sm); color: var(--text-muted); }
        .quick-actions { display: flex; gap: var(--space-md); flex-wrap: wrap; }
        .quick-action-btn {
            display: flex;
            align-items: center;
            gap: var(--space-sm);
            padding: var(--space-md) var(--space-lg);
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            color: var(--text);
            text-decoration: none;
            transition: all var(--transition-fast);
            min-height: 44px;
        }
        .quick-action-btn:hover { background: var(--primary); border-color: var(--primary); color: white; }
        .two-column { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-lg); }
        @media (max-width: 768px) {
            .two-column { grid-template-columns: 1fr; }
            .streak-display { flex-wrap: wrap; }
            .quick-action-btn { flex: 1 1 220px; justify-content: center; }
        }
        @media (max-width: 480px) {
            .quick-action-btn { width: 100%; }
        }
    </style>
    ` }) %>
</head>
<body>
    <%- include('includes/skip-link') %>

    <header>
        <div class="header-content">
            <h1><span class="logo-icon">&#128202;</span> Dashboard</h1>
            <p>Your writing statistics and activity</p>
        </div>
    </header>

    <%- include('includes/nav-app', { currentPage: 'dashboard', showNewEntry: true }) %>

    <main class="page-main" id="main-content" role="main">
        <!-- Quick Actions -->
        <section class="dashboard-section" aria-labelledby="quick-actions-heading">
            <h2 id="quick-actions-heading">&#9889; Quick Actions</h2>
            <div class="quick-actions">
                <a href="/new" class="quick-action-btn">&#10133; New Entry</a>
                <a href="/" class="quick-action-btn">&#128196; View All Entries</a>
                <a href="/?category=daily-learning" class="quick-action-btn">&#128218; Daily Learning</a>
                <a href="/?category=code-snippet" class="quick-action-btn">&#128187; Code Snippets</a>
            </div>
        </section>

        <!-- Stats Grid -->
        <div class="dashboard-grid" role="region" aria-label="Statistics overview">
            <div class="stat-card">
                <span class="stat-icon">&#128196;</span>
                <span class="stat-value" id="totalEntries">-</span>
                <span class="stat-label">Total Entries</span>
            </div>
            <div class="stat-card">
                <span class="stat-icon">&#128221;</span>
                <span class="stat-value" id="totalWords">-</span>
                <span class="stat-label">Total Words</span>
            </div>
            <div class="stat-card">
                <span class="stat-icon">&#128197;</span>
                <span class="stat-value" id="thisWeekEntries">-</span>
                <span class="stat-label">This Week</span>
            </div>
            <div class="stat-card">
                <span class="stat-icon">&#128200;</span>
                <span class="stat-value" id="avgWords">-</span>
                <span class="stat-label">Avg Words/Entry</span>
            </div>
        </div>

        <!-- Writing Streaks -->
        <section class="dashboard-section" aria-labelledby="streaks-heading">
            <h2 id="streaks-heading">&#128293; Writing Streaks</h2>
            <div class="streak-display">
                <div class="streak-item">
                    <span class="streak-value" id="currentStreak">-</span>
                    <span class="streak-label">Current Streak</span>
                </div>
                <div class="streak-item">
                    <span class="streak-value" id="longestStreak">-</span>
                    <span class="streak-label">Longest Streak</span>
                </div>
                <div class="streak-item">
                    <span class="streak-value" id="totalDays">-</span>
                    <span class="streak-label">Total Days Active</span>
                </div>
            </div>
        </section>

        <!-- Activity Chart -->
        <section class="dashboard-section" aria-labelledby="activity-heading">
            <h2 id="activity-heading">&#128200; Activity (Last 30 Days)</h2>
            <div class="chart-container">
                <canvas id="activityChart" role="img" aria-label="Activity chart showing entries over the last 30 days"></canvas>
            </div>
        </section>

        <div class="two-column">
            <!-- Categories Breakdown -->
            <section class="dashboard-section" aria-labelledby="categories-heading">
                <h2 id="categories-heading">&#128193; Categories</h2>
                <div class="category-list" id="categoryList">
                    <!-- Populated by JS -->
                </div>
            </section>

            <!-- Tag Cloud -->
            <section class="dashboard-section" aria-labelledby="tags-heading">
                <h2 id="tags-heading">&#127991; Popular Tags</h2>
                <div class="tag-cloud" id="tagCloud" role="list">
                    <!-- Populated by JS -->
                </div>
            </section>
        </div>

        <!-- Recent Entries -->
        <section class="dashboard-section" aria-labelledby="recent-heading">
            <h2 id="recent-heading">&#128337; Recent Entries</h2>
            <div class="recent-entries-list" id="recentEntries">
                <!-- Populated by JS -->
            </div>
        </section>
    </main>

    <%- include('includes/footer', { showTech: false }) %>

    <script src="/js/auth.js"></script>
    <script src="/js/dashboard.js"></script>
</body>
</html>
