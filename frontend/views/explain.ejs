<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('includes/head', { title: 'AI Explanation', styles: [], extraHead: `
    <style>
        .explain-container {
            max-width: var(--content-max-width);
            margin: 0 auto;
            padding: var(--space-lg);
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: var(--space-lg);
            height: calc(100vh - 180px);
        }
        .explain-main {
            display: flex;
            flex-direction: column;
            background: var(--bg-secondary);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-md);
            overflow: hidden;
        }
        .explain-header {
            padding: var(--space-lg);
            border-bottom: 1px solid var(--border);
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        .explain-header h2 {
            margin: 0 0 var(--space-sm) 0;
            font-size: var(--text-2xl);
            font-weight: 600;
        }
        .explain-header p {
            margin: 0;
            opacity: 0.9;
            font-size: var(--text-sm);
        }
        .conversation-area {
            flex: 1;
            overflow-y: auto;
            padding: var(--space-lg);
            display: flex;
            flex-direction: column;
            gap: var(--space-md);
        }
        .message {
            display: flex;
            gap: var(--space-md);
            animation: fadeIn 0.3s var(--anim-easing);
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .message.user { flex-direction: row-reverse; }
        .message-avatar {
            width: 36px;
            height: 36px;
            border-radius: var(--radius-full);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }
        .message.ai .message-avatar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        .message.user .message-avatar { background: var(--primary); color: white; }
        .message-content {
            flex: 1;
            padding: var(--space-md) var(--space-lg);
            border-radius: var(--radius-lg);
            line-height: 1.6;
            max-width: 85%;
            color: var(--text);
        }
        .message.ai .message-content { background: var(--card); border: 1px solid var(--border); }
        .message.user .message-content { background: var(--primary); color: white; }
        .message-content h1, .message-content h2, .message-content h3 {
            margin: var(--space-md) 0 var(--space-sm) 0;
            font-weight: 600;
            color: var(--text);
        }
        .message.user .message-content h1,
        .message.user .message-content h2,
        .message.user .message-content h3 { color: white; }
        .message-content h1 { font-size: 1.5em; }
        .message-content h2 { font-size: 1.3em; }
        .message-content h3 { font-size: 1.1em; }
        .message-content p { margin: var(--space-sm) 0; }
        .message-content ul, .message-content ol { margin: var(--space-sm) 0; padding-left: var(--space-lg); }
        .message-content li { margin: var(--space-xs) 0; }
        .message-content code {
            background: var(--bg);
            color: var(--primary);
            padding: 2px 6px;
            border-radius: 4px;
            font-family: 'Consolas', 'Monaco', 'Fira Code', monospace;
            font-size: 0.9em;
        }
        .message.user .message-content code { background: rgba(255,255,255,0.2); color: white; }
        .message-content .code-block-wrapper {
            margin: var(--space-md) 0;
            border-radius: var(--radius-md);
            overflow: hidden;
            border: 1px solid var(--border);
            background: var(--bg-secondary);
        }
        .chat-input-area {
            padding: var(--space-md) var(--space-lg);
            border-top: 1px solid var(--border);
            background: var(--bg-secondary);
        }
        .chat-input-container { display: flex; gap: var(--space-md); align-items: flex-end; }
        .chat-input {
            flex: 1;
            padding: 12px var(--space-md);
            background: var(--card);
            border: 2px solid var(--border);
            border-radius: var(--radius-full);
            font-size: var(--text-base);
            font-family: inherit;
            color: var(--text);
            resize: none;
            max-height: 120px;
            transition: border-color var(--transition-fast);
        }
        .chat-input::placeholder { color: var(--text-dim); }
        .chat-input:focus { outline: none; border-color: var(--primary); box-shadow: var(--focus-ring); }
        .chat-input:disabled { opacity: 0.5; cursor: not-allowed; }
        .chat-send-btn {
            padding: 12px var(--space-lg);
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: var(--radius-full);
            font-size: var(--text-base);
            font-weight: 500;
            cursor: pointer;
            min-height: var(--min-touch-target);
            transition: transform var(--transition-fast), opacity var(--transition-fast);
        }
        .chat-send-btn:focus { outline: none; box-shadow: var(--focus-ring); }
        .chat-send-btn:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4); }
        .chat-send-btn:disabled { opacity: 0.5; cursor: not-allowed; }
        .entry-reference {
            background: var(--bg-secondary);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-md);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }
        .reference-header {
            padding: var(--space-md) var(--space-lg);
            background: var(--card);
            border-bottom: 1px solid var(--border);
        }
        .reference-header h3 { margin: 0; font-size: var(--text-base); font-weight: 600; color: var(--text); }
        .reference-content {
            flex: 1;
            overflow-y: auto;
            padding: var(--space-lg);
            font-size: var(--text-sm);
            line-height: 1.6;
            color: var(--text-muted);
        }
        .loading-indicator { display: flex; align-items: center; gap: var(--space-sm); color: var(--text-muted); font-size: var(--text-sm); }
        .loading-spinner {
            width: 16px; height: 16px;
            border: 2px solid var(--border);
            border-top: 2px solid var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        @media (max-width: 1024px) {
            .explain-container { grid-template-columns: 1fr; height: auto; }
            .entry-reference { max-height: 400px; }
        }
        @media (max-width: 768px) {
            .explain-container { padding: var(--space-sm); gap: var(--space-sm); }
            .message-content { max-width: 90%; }
        }
    </style>
    ` }) %>
</head>
<body>
    <%- include('includes/skip-link') %>

    <header>
        <div class="header-content">
            <h1><span class="logo-icon">&#129302;</span> AI Explanation</h1>
            <p>Understand your code better with Atlas AI</p>
        </div>
    </header>

    <%- include('includes/nav-form', {
        backUrl: '/',
        backLabel: 'Back',
        extraButtons: '<a href="/" class="btn-secondary">&#127968; Home</a><a href="/settings" class="btn-secondary">&#9881; Settings</a>'
    }) %>

    <main id="main-content" class="explain-container">
        <div class="explain-main">
            <div class="explain-header">
                <h2 id="entryTitle">Loading...</h2>
                <p id="entryMeta">Preparing explanation...</p>
            </div>

            <div class="conversation-area" id="conversationArea" role="log" aria-live="polite">
                <div class="loading-indicator">
                    <div class="loading-spinner"></div>
                    <span>Generating explanation...</span>
                </div>
            </div>

            <div class="chat-input-area">
                <div class="chat-input-container">
                    <textarea id="chatInput" class="chat-input" placeholder="Ask a follow-up question..." rows="1" disabled></textarea>
                    <button id="sendBtn" class="chat-send-btn" disabled aria-label="Send message">
                        <span>Send &#10148;</span>
                    </button>
                </div>
            </div>
        </div>

        <aside class="entry-reference">
            <div class="reference-header">
                <h3>&#128220; Entry Content</h3>
            </div>
            <div class="reference-content" id="referenceContent">
                <div class="loading-indicator">
                    <div class="loading-spinner"></div>
                    <span>Loading entry...</span>
                </div>
            </div>
        </aside>
    </main>

    <script src="/js/auth.js"></script>
    <script src="/js/explain.js"></script>
</body>
</html>
