<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dev Journal - Personal Developer Documentation</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/win11-explorer.css">
    <link rel="stylesheet" href="/css/animations.css">
</head>
<body>
    <!-- Skip Link for Accessibility -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Header -->
    <header>
        <div class="header-content">
            <h1><span class="logo-icon">&#128221;</span> Dev Journal</h1>
            <p>Personal developer journal for daily learnings, project notes, and code snippets</p>
        </div>
    </header>

    <!-- Windows 11 Style Navigation -->
    <nav>
        <div class="nav-container">
            <a href="/" class="nav-brand">&#128218; Dev Journal</a>

            <!-- Windows 11 Style Nav Links -->
            <div class="win11-nav-links" id="navLinks">
                <a href="/" class="win11-nav-link active">&#127968; Home</a>
                <a href="/dashboard" class="win11-nav-link">&#128202; Dashboard</a>
                <a href="/settings" class="win11-nav-link">&#9881; Settings</a>
                <a href="/admin" class="win11-nav-link" id="adminNavLink" style="display: none;">
                    &#9881; Admin <span class="admin-badge">Admin</span>
                </a>
            </div>

            <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle menu">
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
            </button>

            <div class="nav-actions" id="navActions">
                <div class="mobile-nav-links">
                    <a href="/">&#127968; Home</a>
                    <a href="/dashboard">&#128202; Dashboard</a>
                    <a href="/settings">&#9881; Settings</a>
                </div>
                <span id="userDisplay" class="user-display"></span>
                <button id="logoutBtn" class="btn-logout">Logout</button>
            </div>
        </div>
    </nav>

    <!-- Windows 11 File Explorer Main Content -->
    <main class="win11-explorer" id="main-content">
        <!-- Toolbar -->
        <div class="win11-toolbar">
            <div class="toolbar-left">
                <a href="/new" class="toolbar-btn primary" id="newEntryBtn">
                    <span class="btn-icon">&#10133;</span>
                    <span class="btn-label">New</span>
                </a>
                <button class="toolbar-btn" id="newFolderBtn" title="New Folder">
                    <span class="btn-icon">&#128193;</span>
                    <span class="btn-label">Folder</span>
                </button>
                <div class="toolbar-separator"></div>
                <button class="toolbar-btn" id="refreshBtn" title="Refresh" aria-label="Refresh">
                    <span class="btn-icon">&#128260;</span>
                </button>
                <button class="toolbar-btn" id="favoriteBtn" title="Add to Favorites" aria-label="Add to Favorites" disabled>
                    <span class="btn-icon">&#9733;</span>
                </button>
                <div class="toolbar-separator"></div>
                <button class="toolbar-btn danger" id="deleteBtn" title="Delete" aria-label="Delete selected" disabled>
                    <span class="btn-icon">&#128465;</span>
                </button>
                <div class="toolbar-separator"></div>
                <button class="toolbar-btn ai-btn" id="aiSummarizeBtn" title="Summarize folder with AI" aria-label="Summarize folder with AI">
                    <span class="btn-icon">&#129302;</span>
                    <span class="btn-label">Summarize</span>
                </button>
                <button class="toolbar-btn ai-btn" id="aiAskBtn" title="Ask AI" aria-label="Ask AI">
                    <span class="btn-icon">&#128172;</span>
                    <span class="btn-label">Ask AI</span>
                </button>
            </div>
            <div class="toolbar-right">
                <div class="toolbar-dropdown-container" style="position: relative;">
                    <button class="toolbar-dropdown" id="sortDropdown">
                        <span>Sort</span>
                        <span class="dropdown-arrow">&#9660;</span>
                    </button>
                    <div class="dropdown-menu" id="sortMenu" role="menu" aria-label="Sort options">
                        <div class="dropdown-item active" data-sort="date-desc" role="menuitem" tabindex="-1">
                            <span class="check-icon">&#10003;</span>
                            <span>Date (Newest)</span>
                        </div>
                        <div class="dropdown-item" data-sort="date-asc" role="menuitem" tabindex="-1">
                            <span class="check-icon">&#10003;</span>
                            <span>Date (Oldest)</span>
                        </div>
                        <div class="dropdown-item" data-sort="name-asc" role="menuitem" tabindex="-1">
                            <span class="check-icon">&#10003;</span>
                            <span>Name (A-Z)</span>
                        </div>
                        <div class="dropdown-item" data-sort="name-desc" role="menuitem" tabindex="-1">
                            <span class="check-icon">&#10003;</span>
                            <span>Name (Z-A)</span>
                        </div>
                        <div class="dropdown-item" data-sort="type-asc" role="menuitem" tabindex="-1">
                            <span class="check-icon">&#10003;</span>
                            <span>Type</span>
                        </div>
                    </div>
                </div>
                <div class="toolbar-dropdown-container" style="position: relative;">
                    <button class="toolbar-dropdown" id="viewDropdown">
                        <span>View</span>
                        <span class="dropdown-arrow">&#9660;</span>
                    </button>
                    <div class="dropdown-menu" id="viewMenu" role="menu" aria-label="View options">
                        <div class="dropdown-item active" data-view="details" role="menuitem" tabindex="-1">
                            <span class="check-icon">&#10003;</span>
                            <span>&#9776; Details</span>
                        </div>
                        <div class="dropdown-item" data-view="tiles" role="menuitem" tabindex="-1">
                            <span class="check-icon">&#10003;</span>
                            <span>&#9638; Tiles</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Address Bar -->
        <div class="win11-addressbar">
            <div class="nav-buttons">
                <button class="nav-btn" id="backBtn" title="Back" aria-label="Go back" disabled>&#9664;</button>
                <button class="nav-btn" id="forwardBtn" title="Forward" aria-label="Go forward" disabled>&#9654;</button>
                <button class="nav-btn" id="upBtn" title="Up" aria-label="Go up one level">&#9650;</button>
                <button class="nav-btn" id="sidebarToggle" title="Toggle Sidebar" aria-label="Toggle sidebar">&#9776;</button>
            </div>
            <nav class="breadcrumb-container" aria-label="Breadcrumb">
                <ol class="breadcrumb-path" id="breadcrumbPath">
                    <li><a href="#" class="breadcrumb-item" data-path="home">&#127968; Home</a></li>
                    <li class="breadcrumb-separator" aria-hidden="true">&#8250;</li>
                    <li aria-current="location"><span class="breadcrumb-current" id="breadcrumbCurrent">All Entries</span></li>
                </ol>
            </nav>
            <div class="win11-search">
                <input type="text" id="searchInput" placeholder="Search Dev-Journal" aria-label="Search entries">
                <button class="search-btn" id="searchBtn" aria-label="Search">&#128269;</button>
            </div>
        </div>

        <!-- Tabs -->
        <div class="win11-tabs">
            <button class="win11-tab active" data-tab="recent">
                <span class="tab-icon">&#128337;</span>
                <span>Recent</span>
            </button>
            <button class="win11-tab" data-tab="favorites">
                <span class="tab-icon">&#9733;</span>
                <span>Favorites</span>
            </button>
            <button class="win11-tab" data-tab="all">
                <span class="tab-icon">&#128193;</span>
                <span>All Entries</span>
            </button>
        </div>

        <!-- Main Content Area -->
        <div class="win11-main">
            <!-- Sidebar -->
            <aside class="win11-sidebar" id="win11Sidebar">
                <!-- Home Section -->
                <div class="sidebar-section">
                    <a href="/" class="sidebar-item active" data-path="home">
                        <span class="item-icon">&#127968;</span>
                        <span class="item-text">Home</span>
                    </a>
                    <a href="/dashboard" class="sidebar-item">
                        <span class="item-icon">&#128202;</span>
                        <span class="item-text">Dashboard</span>
                    </a>
                    <a href="/new" class="sidebar-item">
                        <span class="item-icon">&#10133;</span>
                        <span class="item-text">New Entry</span>
                    </a>
                </div>

                <!-- Quick Access (Categories) -->
                <div class="sidebar-section">
                    <button class="section-header" type="button" aria-expanded="true" aria-controls="quickaccess">
                        <span class="collapse-arrow">&#9660;</span>
                        <span class="section-title">Quick Access</span>
                    </button>
                    <div class="section-content" id="quickaccess">
                        <a href="#" class="sidebar-item" data-category="daily-learning">
                            <span class="item-icon folder-icon blue">&#128193;</span>
                            <span class="item-text">Daily Learning</span>
                            <span class="item-count" id="count-daily-learning">0</span>
                        </a>
                        <a href="#" class="sidebar-item" data-category="project-note">
                            <span class="item-icon folder-icon green">&#128193;</span>
                            <span class="item-text">Project Notes</span>
                            <span class="item-count" id="count-project-note">0</span>
                        </a>
                        <a href="#" class="sidebar-item" data-category="bug-fix">
                            <span class="item-icon folder-icon red">&#128193;</span>
                            <span class="item-text">Bug Fixes</span>
                            <span class="item-count" id="count-bug-fix">0</span>
                        </a>
                        <a href="#" class="sidebar-item" data-category="code-snippet">
                            <span class="item-icon folder-icon purple">&#128193;</span>
                            <span class="item-text">Code Snippets</span>
                            <span class="item-count" id="count-code-snippet">0</span>
                        </a>
                        <a href="#" class="sidebar-item" data-category="concept">
                            <span class="item-icon folder-icon yellow">&#128193;</span>
                            <span class="item-text">Concepts</span>
                            <span class="item-count" id="count-concept">0</span>
                        </a>
                    </div>
                </div>

                <!-- Favorites -->
                <div class="sidebar-section">
                    <button class="section-header" type="button" aria-expanded="true" aria-controls="favorites-section">
                        <span class="collapse-arrow">&#9660;</span>
                        <span class="section-title">Favorites</span>
                    </button>
                    <div class="section-content" id="favorites-section">
                        <div id="favoritesList">
                            <div class="sidebar-item" style="color: var(--win11-text-muted); font-style: italic;">
                                No favorites yet
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tags -->
                <div class="sidebar-section">
                    <button class="section-header" type="button" aria-expanded="false" aria-controls="tags-section">
                        <span class="collapse-arrow collapsed">&#9660;</span>
                        <span class="section-title">Tags</span>
                    </button>
                    <div class="section-content collapsed" id="tags-section">
                        <div id="tagsList">
                            <!-- Tags loaded dynamically -->
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Sidebar Overlay for Mobile -->
            <div class="win11-sidebar-overlay" id="sidebarOverlay"></div>

            <!-- Content Area -->
            <section class="win11-content">
                <!-- Quick Access Grid (Home View) -->
                <div class="quick-access-grid" id="quickAccessGrid">
                    <h3>&#9733; Pinned</h3>
                    <div class="pinned-folders" id="pinnedFolders">
                        <a href="#" class="pinned-folder" data-category="daily-learning">
                            <span class="folder-icon-lg" style="color: var(--folder-blue);">&#128193;</span>
                            <span class="folder-name">Daily Learning</span>
                            <span class="folder-count" id="pinned-daily-learning">0 items</span>
                        </a>
                        <a href="#" class="pinned-folder" data-category="project-note">
                            <span class="folder-icon-lg" style="color: var(--folder-green);">&#128193;</span>
                            <span class="folder-name">Project Notes</span>
                            <span class="folder-count" id="pinned-project-note">0 items</span>
                        </a>
                        <a href="#" class="pinned-folder" data-category="bug-fix">
                            <span class="folder-icon-lg" style="color: var(--folder-red);">&#128193;</span>
                            <span class="folder-name">Bug Fixes</span>
                            <span class="folder-count" id="pinned-bug-fix">0 items</span>
                        </a>
                        <a href="#" class="pinned-folder" data-category="code-snippet">
                            <span class="folder-icon-lg" style="color: var(--folder-purple);">&#128193;</span>
                            <span class="folder-name">Code Snippets</span>
                            <span class="folder-count" id="pinned-code-snippet">0 items</span>
                        </a>
                        <a href="#" class="pinned-folder" data-category="concept">
                            <span class="folder-icon-lg" style="color: var(--folder-yellow);">&#128193;</span>
                            <span class="folder-name">Concepts</span>
                            <span class="folder-count" id="pinned-concept">0 items</span>
                        </a>
                    </div>
                    <h3>&#128337; Recent</h3>
                </div>

                <!-- File List Container -->
                <div class="file-list-container" id="fileListContainer">
                    <!-- File List Header -->
                    <div class="file-list-header" id="fileListHeader">
                        <div class="col-header sorted" data-sort="name">
                            <span>Name</span>
                            <span class="sort-icon">&#9660;</span>
                        </div>
                        <div class="col-header" data-sort="date">
                            <span>Date Modified</span>
                            <span class="sort-icon">&#9660;</span>
                        </div>
                        <div class="col-header" data-sort="type">
                            <span>Type</span>
                            <span class="sort-icon">&#9660;</span>
                        </div>
                        <div class="col-header">
                            <span>Tags</span>
                        </div>
                    </div>

                    <!-- File List -->
                    <div class="file-list" id="fileList" aria-live="polite">
                        <!-- Entries loaded dynamically -->
                    </div>

                    <!-- Loading State -->
                    <div class="win11-loading" id="loadingState" role="status" aria-live="polite" style="display: none;">
                        <div class="win11-spinner"></div>
                        <p style="margin-top: var(--space-md); color: var(--win11-text-secondary);">Loading entries...</p>
                    </div>

                    <!-- Empty State -->
                    <div class="empty-state" id="emptyState" role="status" aria-live="polite" style="display: none;">
                        <span class="empty-icon">&#128466;</span>
                        <h3 class="empty-title">No entries found</h3>
                        <p class="empty-text">Create your first journal entry to get started</p>
                        <a href="/new" class="empty-action">+ New Entry</a>
                    </div>
                </div>
            </section>
        </div>

        <!-- Status Bar -->
        <div class="win11-statusbar">
            <div class="statusbar-left">
                <span id="itemCount" aria-live="polite">0 items</span>
                <span id="selectedCount"></span>
            </div>
            <div class="statusbar-right">
                <div class="view-mode-toggle">
                    <button class="view-mode-btn active" id="detailsViewBtn" title="Details" aria-label="Details view">&#9776;</button>
                    <button class="view-mode-btn" id="tilesViewBtn" title="Tiles" aria-label="Tiles view">&#9638;</button>
                </div>
            </div>
        </div>
    </main>

    <footer>
        <div class="footer-content">
            <p>Dev Journal - Personal Developer Documentation System</p>
            <p>Built with Node.js, Express, MongoDB Atlas</p>
        </div>
    </footer>

    <script src="/js/auth.js"></script>
    <script src="/js/app.js"></script>
    <script src="/js/fileExplorer.js"></script>
</body>
</html>
