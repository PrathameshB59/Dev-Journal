<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('includes/head', { title: 'Login', styles: [], extraHead: '' }) %>
</head>
<body>
    <%- include('includes/skip-link') %>

    <header>
        <div class="header-content">
            <h1><span class="logo-icon">&#128274;</span> Login</h1>
            <p>Sign in to your Dev Journal account</p>
        </div>
    </header>

    <%- include('includes/nav-auth', { brandHref: '/login' }) %>

    <main id="main-content" class="page-main auth-page">
        <div class="auth-container">
            <form id="loginForm" class="entry-form auth-form">
                <%- include('includes/message') %>

                <div class="form-group">
                    <label for="email">Email *</label>
                    <input type="email" id="email" name="email" required
                           placeholder="Enter your email..." autocomplete="email">
                </div>

                <div class="form-group">
                    <label for="password">Password *</label>
                    <input type="password" id="password" name="password" required
                           minlength="8" placeholder="Enter your password..." autocomplete="current-password">
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-primary btn-full">&#10003; Sign In</button>
                </div>

                <p class="auth-link">
                    Don't have an account? <a href="/register">Register here</a>
                </p>
            </form>
        </div>
    </main>

    <%- include('includes/footer', { showTech: false }) %>

    <script src="/js/auth.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (Auth.redirectIfAuthenticated()) return;

            const form = document.getElementById('loginForm');
            const formMessage = document.getElementById('formMessage');

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                formMessage.style.display = 'none';

                const email = document.getElementById('email').value.trim();
                const password = document.getElementById('password').value;

                const submitBtn = form.querySelector('button[type="submit"]');
                submitBtn.disabled = true;
                submitBtn.innerHTML = '&#8987; Signing in...';

                try {
                    const result = await AuthAPI.login(email, password);

                    if (result.success) {
                        Auth.setAuth(result.data.token, result.data.user);
                        formMessage.className = 'form-message success';
                        formMessage.textContent = 'Login successful! Redirecting...';
                        formMessage.style.display = 'block';

                        setTimeout(() => {
                            window.location.href = '/';
                        }, 1000);
                    } else {
                        formMessage.className = 'form-message error';
                        formMessage.textContent = result.error || 'Login failed';
                        formMessage.style.display = 'block';
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '&#10003; Sign In';
                    }
                } catch (error) {
                    formMessage.className = 'form-message error';
                    formMessage.textContent = 'Login failed: ' + error.message;
                    formMessage.style.display = 'block';
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '&#10003; Sign In';
                }
            });
        });
    </script>
</body>
</html>
