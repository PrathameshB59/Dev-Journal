<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('includes/head', { title: 'Edit Entry', styles: ['animations.css'], extraHead: '' }) %>
</head>
<body>
    <%- include('includes/skip-link') %>

    <header>
        <div class="header-content">
            <h1><span class="logo-icon">&#9998;</span> Edit Entry</h1>
            <p>Update your journal entry</p>
        </div>
    </header>

    <%- include('includes/nav-form', { backUrl: '/', backLabel: 'Back to Journal' }) %>

    <main id="main-content" class="container form-container">
        <div id="loadingIndicator" class="loading">
            <div class="spinner"></div>
            <p>Loading entry...</p>
        </div>

        <form id="editForm" class="entry-form" style="display: none;">
            <input type="hidden" id="entryId">

            <div class="form-group">
                <label for="title">Title *</label>
                <input type="text" id="title" name="title" required maxlength="200" placeholder="Enter entry title...">
            </div>

            <div class="form-group">
                <label for="category">Category *</label>
                <select id="category" name="category" required>
                    <option value="">Select a category</option>
                    <option value="daily-learning">&#128218; Daily Learning</option>
                    <option value="project-note">&#128196; Project Note</option>
                    <option value="bug-fix">&#128027; Bug Fix</option>
                    <option value="code-snippet">&#128187; Code Snippet</option>
                    <option value="concept">&#128161; Concept</option>
                </select>
            </div>

            <div class="form-group">
                <label for="content">Content *</label>
                <div class="editor-toolbar">
                    <button type="button" class="editor-mode-btn active" data-mode="edit">Edit</button>
                    <button type="button" class="editor-mode-btn" data-mode="split">Split</button>
                    <button type="button" class="editor-mode-btn" data-mode="preview">Preview</button>
                    <span class="editor-toolbar-divider" aria-hidden="true"></span>
                    <button type="button" class="editor-tool-btn" id="insertMediaBtn">&#128247; Insert Media</button>
                    <input
                        type="file"
                        id="entryMediaInput"
                        name="entryMediaInput"
                        hidden
                        accept="image/jpeg,image/png,image/webp,image/gif,audio/mpeg,audio/wav,audio/ogg,audio/mp4,video/mp4,video/webm,video/ogg"
                    >
                </div>
                <div class="editor-container" data-mode="edit">
                    <textarea id="content" name="content" required rows="12" placeholder="Write your entry content here... (Markdown supported)"></textarea>
                    <div id="markdownPreview" class="markdown-preview"></div>
                </div>
            </div>

            <div class="form-group">
                <label for="tags">Tags (comma separated)</label>
                <input type="text" id="tags" name="tags" placeholder="javascript, nodejs, express">
            </div>

            <div class="form-group code-section">
                <label>Code Block (Optional)</label>
                <div class="code-inputs">
                    <input type="text" id="codeLanguage" name="codeLanguage" placeholder="Language (e.g., javascript, python)">
                    <textarea id="codeBlock" name="codeBlock" rows="8" placeholder="Paste your code here..."></textarea>
                </div>
            </div>

            <div class="form-actions">
                <button type="button" class="btn-secondary" onclick="history.back()">Cancel</button>
                <button type="submit" class="btn-primary">&#10003; Save Changes</button>
            </div>
        </form>

        <%- include('includes/message') %>
    </main>

    <%- include('includes/footer', { showTech: false }) %>

    <script src="/js/auth.js"></script>
    <script src="/js/app.js?v=20260216c"></script>
    <script src="/js/markdownPreview.js"></script>
</body>
</html>
